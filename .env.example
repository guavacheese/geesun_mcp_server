# =============================================================
# geesun_mcp_server 环境变量模板（本地开发 / Docker 部署共用）
# 用法：cp .env.example .env  然后按实际环境填值
# ⚠️ .env 已被 .gitignore 忽略，含密钥（E2B_API_KEY 等），绝不入库、不进镜像
# =============================================================

# ── 文件解密 API（企业 DLP 文档解密服务）──
# agent 侧 decrypt_and_upload_to_sandbox / decrypt_file_to_base64 等工具的后端地址
DECRYPT_API_URL=http://10.10.10.17:8090/common-file/anony/revolveAdminFile

# ── CubeSandbox / E2B API（沙箱执行环境）──
# 172.16.66.13:6000 为裸金属 CubeMaster（Rocky9）cube-api 端口
E2B_API_URL=http://172.16.66.13:6000
# 沙箱凭据（robot key，敏感）；内网环境默认 e2b_000... 占位，生产必须替换
E2B_API_KEY=e2b_0000000000000000000000000000000000000000

# ── 沙箱侧 TLS 根证书（Cube 自带 CA）──
# 沙箱内访问 cube-api 需信任该 CA；留空则不注入
SSL_CERT_FILE=/home/dhp/projects/cube-cert/rootCA.pem

# ── 路径（本地开发时指向 agent 仓库的挂载/数据目录）──
# 沙箱/agent 内访问这些目录；值应与 geesun_agent 侧 env 保持一致
AGENT_WORKSPACE=/mnt/d/workspace/geesun_agent
UPLOAD_ROOT=/mnt/d/workspace/geesun_agent/data/uploads
REPORT_ROOT=/mnt/d/workspace/geesun_agent/data/reports
